# HTTPS automático (Let's Encrypt) para isaidev.site. El DNS debe apuntar a este servidor.
isaidev.site {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Archivos con hash en el nombre: cache de un año
	handle /_astro/* {
		reverse_proxy app:4321 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	handle {
		reverse_proxy app:4321
	}
}

www.isaidev.site {
	redir https://isaidev.site{uri} permanent
}
