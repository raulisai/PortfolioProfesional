---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '../data/site';
const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const [h1, h2, h3] = site.experienceHeading;
---
<section id="experiencia" class="relative flex min-h-dvh flex-col justify-center overflow-clip px-6 pb-8 pt-20 md:block md:min-h-0 md:px-10 md:py-36" aria-label="Experiencia">
  <div class="pointer-events-none absolute -left-40 top-10 size-[36rem] rounded-full bg-accent/10 blur-[140px]" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl gap-6 md:grid-cols-[1fr_1.35fr] md:gap-20">
    <div class="md:sticky md:top-32 md:self-start">
      <p class="reveal eyebrow">Experiencia</p>
      <h2 class="reveal mt-3 text-[clamp(1.9rem,8.4vw,2.4rem)] font-bold leading-[1.08] md:text-[clamp(2.4rem,5vw,4.2rem)] md:leading-[1.05] tracking-tight" style="--i:1">
        {h1}<br /><span class="text-gradient">{h2}</span><br />{h3}
      </h2>
    </div>

    <ol class="relative" data-timeline>
      <div class="tl-line" aria-hidden="true"><div class="tl-fill"></div></div>
      {jobs.map((j, i) => (
        <li class="reveal relative grid grid-cols-[23px_1fr] gap-4 pb-5 last:pb-0 md:pb-12" style={`--i:${i}`} data-job>
          <span class="tl-node mt-1" aria-hidden="true"></span>
          <div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              {j.data.logo
                ? <Image src={j.data.logo} alt="" class="size-7 rounded-lg object-contain md:size-8" width={64} height={64} />
                : <span class="grid size-7 place-items-center md:size-8 rounded-lg border border-line bg-white/[.04] text-sm font-semibold text-accent" aria-hidden="true">{j.data.company[0]}</span>}
              <h3 class="text-base font-semibold md:text-lg">{j.data.company}</h3>
              <span class="ml-auto text-xs tabular-nums text-muted md:text-sm">{j.data.start} — {j.data.end ?? 'Actualidad'}</span>
            </div>
            <p class="mt-0.5 pl-11 text-[0.8rem] text-fg/80 md:mt-1 md:text-sm">{j.data.role}</p>
            <p class="mt-1 max-w-lg pl-11 text-[0.75rem] leading-snug text-muted md:mt-2 md:text-sm md:leading-relaxed">{j.data.summary}</p>
            {j.data.stack.length > 0 && (
              <>
                <p class="mt-1 truncate pl-11 text-[0.68rem] text-accent/80 md:hidden">{j.data.stack.join(' · ')}</p>
                <ul class="ex-chips mt-4 hidden flex-wrap gap-2 pl-11 md:flex">{j.data.stack.map((s) => <li class="chip">{s}</li>)}</ul>
              </>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // La línea se "dibuja" con el scroll y enciende cada nodo al pasar
  const tl = document.querySelector<HTMLElement>('[data-timeline]')!;
  const fill = tl.querySelector<HTMLElement>('.tl-fill')!;
  const jobs = [...tl.querySelectorAll<HTMLElement>('[data-job]')];
  let queued = false;
  const update = () => {
    queued = false;
    const r = tl.getBoundingClientRect();
    const mark = innerHeight * 0.65;
    const p = Math.min(1, Math.max(0, (mark - r.top) / r.height));
    fill.style.setProperty('--p', p.toFixed(3));
    jobs.forEach((j) => j.classList.toggle('lit', j.getBoundingClientRect().top + 12 < mark));
  };
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  update();
</script>
