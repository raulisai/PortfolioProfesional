---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { techIcon } from '../data/tech-icons';
const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const n = jobs.length;
const heads = [...jobs.map((j) => j.data.headline), site.experienceHeading]; // el último es el título final

// Fondo: tres filas de tecnologías por trabajo, con el orden rotado para que no coincidan
const rows = (list: string[]) => {
  const k = Math.ceil(list.length / 3);
  return [list, [...list.slice(k), ...list.slice(0, k)], [...list.slice(2 * k), ...list.slice(0, 2 * k)]];
};
// Cada mitad de la fila repite la lista hasta llenar de sobra la pantalla
const fill = (list: string[]) => Array.from({ length: Math.max(2, Math.ceil(12 / list.length)) }, () => list).flat();
---
<section id="experiencia" data-xp data-step={n} data-n={n} style={`--n:${n}`} class="xp relative" aria-label="Experiencia">
  <div class="xp-stick">
    <div class="xp-bg" aria-hidden="true">
      {jobs.map((j) => (
        <div class="xp-tech past" data-tech>
          {rows(j.data.tech).map((row, r) => (
            <div class={`xp-row xp-row-${r}`}>
              <div class="xp-track">
                {[0, 1].map(() => (
                  <div class="xp-seq">
                    {fill(row).map((t) => {
                      const ic = techIcon(t);
                      return (
                        <span class="xp-pill" style={`--c:${ic.color}`}>
                          <i class="xp-ico">
                            {ic.kind === 'brand'
                              ? <svg viewBox="0 0 24 24" fill="currentColor"><path d={ic.path} /></svg>
                              : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={ic.path} /></svg>}
                          </i>
                          {t}
                        </span>
                      );
                    })}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
    <div class="pointer-events-none absolute -left-40 top-10 size-[36rem] rounded-full bg-accent/10 blur-[140px]" aria-hidden="true"></div>
    <div class="relative mx-auto grid w-full max-w-6xl gap-5 md:grid-cols-[1fr_1.35fr] md:items-start md:gap-20">
      <div class="md:pt-[7dvh]">
        <p class="eyebrow">Experiencia <span data-xp-count class="ml-2 tabular-nums text-mint"></span></p>
        <div class="mt-3 grid md:mt-5">
          {heads.map(([a, b, c], k) => (
            <h2 data-head class:list={['xp-h text-[clamp(1.9rem,8.4vw,2.4rem)] font-bold leading-[1.08] tracking-tight md:text-[clamp(2.4rem,5vw,4.2rem)] md:leading-[1.05]', k === n && 'on']} aria-hidden={k === n ? undefined : 'true'}>
              {a}<br /><span class="text-gradient">{b}</span><br />{c}
            </h2>
          ))}
        </div>
        <p class="xp-stats mt-6 hidden text-sm tracking-wide text-muted md:block">{site.experienceStats}</p>
      </div>

      <ol class="relative">
        {jobs.map((j) => (
          <li class="xp-job lit relative grid grid-cols-[23px_1fr] gap-4" data-job data-state="done" data-final>
            <span class="tl-node mt-1" aria-hidden="true"></span>
            <div>
              <div class="xp-head flex flex-wrap items-center gap-x-3 gap-y-1">
                {j.data.logo
                  ? <Image src={j.data.logo} alt="" class="size-7 rounded-lg object-contain md:size-8" width={64} height={64} />
                  : <span class="grid size-7 place-items-center rounded-lg border border-line bg-white/[.04] text-sm font-semibold text-accent md:size-8" aria-hidden="true">{j.data.company[0]}</span>}
                <h3 class="xp-company text-base font-semibold md:text-lg">{j.data.company}</h3>
                <span class="ml-auto text-xs tabular-nums text-muted md:text-sm">{j.data.start} — {j.data.end ?? 'Actualidad'}</span>
              </div>
              <p class="mt-0.5 pl-11 text-[0.8rem] text-fg/80 md:mt-1 md:text-sm">{j.data.role}</p>

              <!-- Detalle: solo mientras la experiencia está en foco -->
              <div class="xp-fold xp-detail-fold"><div class="inner">
                <div class="pl-11 pt-2 md:pt-3">
                  <p class="max-w-lg text-[0.75rem] leading-snug text-fg/85 md:text-sm md:leading-relaxed">{j.data.challenge}</p>
                  <ul class="mt-2.5 flex flex-wrap gap-1.5 md:mt-3.5 md:gap-2">
                    {j.data.learned.map((l) => <li class="chip !border-accent/35 !bg-accent/10 !px-2.5 !py-0.5 !text-[0.68rem] !text-[#dfe2ff] md:!px-[0.85rem] md:!py-[0.35rem] md:!text-[0.78rem]">{l}</li>)}
                  </ul>
                </div>
              </div></div>

              <!-- Versión compacta final -->
              <div class="xp-fold xp-sum-fold"><div class="inner">
                <p class="mt-1 max-w-lg pl-11 text-[0.75rem] leading-snug text-muted md:mt-2 md:text-sm md:leading-relaxed">{j.data.summary}</p>
                {j.data.stack.length > 0 && (
                  <>
                    <p class="mt-1 truncate pl-11 text-[0.68rem] text-accent/80 md:hidden">{j.data.stack.join(' · ')}</p>
                    <ul class="ex-chips mt-3 hidden flex-wrap gap-2 pl-11 md:flex">{j.data.stack.map((s) => <li class="chip">{s}</li>)}</ul>
                  </>
                )}
              </div></div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-xp]')!;
  const n = Number(sec.dataset.n);
  const jobs = [...sec.querySelectorAll<HTMLElement>('[data-job]')];
  const heads = [...sec.querySelectorAll<HTMLElement>('[data-head]')];
  const count = sec.querySelector<HTMLElement>('[data-xp-count]')!;
  const techs = [...sec.querySelectorAll<HTMLElement>('[data-tech]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let last = Infinity;

  // step: -1 = todo oculto · 0..n-1 = experiencia en foco · n = diseño final compacto
  const apply = (step: number) => {
    if (step === last) return;
    last = step;
    sec.dataset.step = String(step);
    jobs.forEach((j, i) => {
      const state = i > step ? 'pending' : i === step ? 'focus' : 'done';
      j.dataset.state = state;
      j.classList.toggle('lit', state !== 'pending');
      j.toggleAttribute('data-final', step >= n);
    });
    const h = step < 0 ? 0 : step;
    heads.forEach((el, k) => { el.classList.toggle('on', k === h); el.toggleAttribute('aria-hidden', k !== h); });
    // Las tecnologías del trabajo anterior salen por la izquierda y entran las nuevas por la derecha
    // En el estado final ya están todos los puestos en pantalla: las tecnologías se retiran
    techs.forEach((el, k) => { el.classList.toggle('on', k === h && step < n); el.classList.toggle('past', k < h || step >= n); });
    sec.toggleAttribute('data-final', step >= n);
    count.textContent = step >= 0 && step < n ? `${String(step + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}` : '';
  };

  if (reduce) {
    sec.classList.add('xp-static');
    apply(n);
  } else {
    let queued = false;
    let lastY = scrollY;
    let collapsed = false;

    // Al subir: la secuencia no se repite. Se compacta la sección al diseño final y se
    // compensa el scroll para que la pantalla no se mueva.
    const collapse = (r: DOMRect) => {
      const y0 = scrollY; // antes de que el navegador recorte el scroll al encoger la página
      const top = y0 + r.top;
      const stageTop = Math.min(Math.max(y0, top), top + r.height - innerHeight);
      sec.classList.add('xp-collapsed');
      collapsed = true;
      apply(n);
      scrollTo({ top: y0 - (stageTop - top), behavior: 'instant' });
      lastY = scrollY;
    };

    const update = () => {
      queued = false;
      const dir = Math.sign(scrollY - lastY);
      lastY = scrollY;
      const r = sec.getBoundingClientRect();

      if (collapsed) {
        // Al bajar otra vez desde arriba, la secuencia vuelve a estar disponible
        if (dir > 0 && r.top > innerHeight * 0.45) { sec.classList.remove('xp-collapsed'); collapsed = false; return apply(-1); }
        return apply(n);
      }
      if (dir < 0 && r.top < 0 && r.bottom > 0) return collapse(r);

      const total = Math.max(1, r.height - innerHeight);
      if (r.top > innerHeight * 0.45) return apply(-1);
      if (r.bottom < 0) return apply(n);
      const p = Math.min(1, Math.max(0, -r.top / total));
      apply(Math.min(n, Math.floor(p * (n + 1))));
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
