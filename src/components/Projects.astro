---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import space from '../assets/scene/space.webp';
import mountains from '../assets/scene/mountains.webp';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const total = projects.length;
const pad = (n: number) => String(n).padStart(2, '0');
// Separa la última palabra del título para resaltarla
const split = (t: string) => {
  const i = t.lastIndexOf(' ');
  return i < 0 ? ['', t] : [t.slice(0, i + 1), t.slice(i + 1)];
};
const arrow = 'M3 9 9 3M4 3h5v5';
---
<section id="proyectos" data-stage class="stage relative isolate h-dvh min-h-[540px] overflow-clip md:min-h-[680px]" aria-roledescription="carrusel" aria-label="Proyectos">
  <!-- Escena: capas a distintas profundidades -->
  <div class="scene" aria-hidden="true">
    <div class="layer" style="--d:.12">
      <Image src={space} alt="" class="scene-space" widths={[900, 1400, 1774]} sizes="125vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="layer scene-glow" style="--d:.35"></div>
    <div class="layer" style="--d:.8">
      <Image src={mountains} alt="" class="scene-mountains" widths={[1000, 1600, 2000]} sizes="135vw" loading="eager" />
    </div>
    <div class="scene-shade"></div>
  </div>

  <div data-content class="stage-content relative z-10 flex h-full flex-col">
    <!-- Contador 01 / 04 -->
    <div class="absolute left-5 top-[4.75rem] z-20 flex flex-col items-center gap-1.5 text-sm font-medium tabular-nums md:left-10 md:top-[17%] md:gap-2">
      <span class="block h-5 overflow-hidden"><span data-count class="block">01</span></span>
      <span class="relative h-9 w-px bg-white/15 md:h-14"><span data-count-fill class="absolute inset-x-0 top-0 bg-mint shadow-[0_0_8px_var(--color-mint)] transition-[height] duration-700" style={`height:${100 / total}%`}></span></span>
      <span class="text-muted">{pad(total)}</span>
    </div>

    <div class="grid min-h-0 flex-1 grid-rows-[minmax(0,1fr)_auto] md:grid-cols-[1.4fr_1fr] md:grid-rows-none md:items-center md:gap-14 md:pl-36 md:pr-24 lg:pr-28">
      <!-- Capturas en marco de dispositivo -->
      <div class="media-col relative flex min-h-0 items-center justify-center px-14 pb-2 pt-[4.5rem] md:block md:px-0 md:pb-0 md:pt-4">
        <!-- Flechas (mobile): a los costados de la imagen -->
        <button type="button" data-prev class="arrow-m left-1" aria-label="Proyecto anterior">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" data-next class="arrow-m right-1" aria-label="Proyecto siguiente">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class="media-par w-full">
          <div class="float">
            <div class="device-tilt" data-tilt>
              {projects.map((p, i) => (
                <div data-media class:list={['slide-media device', i === 0 && 'is-active']}>
                  <div data-screen data-vw={p.data.viewport} class="screen relative mx-auto aspect-[16/10] w-[min(100%,calc(clamp(120px,32dvh,360px)*1.6))] overflow-hidden rounded-[14px] bg-black md:w-full md:rounded-[22px]">
                    <Image src={p.data.cover} alt={`Vista previa de ${p.data.title}`} widths={[700, 1100, 1440]} sizes="(min-width: 768px) 55vw, 90vw" loading={i === 0 ? 'eager' : 'lazy'} class="absolute inset-0 h-full w-full object-cover" />
                    {p.data.embed && (
                      <iframe data-frame data-src={p.data.url} title={`${p.data.title} en vivo`} class="frame pointer-events-none absolute left-0 top-0 origin-top-left border-0 bg-white opacity-0 transition-opacity duration-700" allow="autoplay; fullscreen; microphone; camera; clipboard-write" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-pointer-lock allow-modals" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    )}
                    <a href={p.data.url} target="_blank" rel="noopener" data-cta data-embed={p.data.embed ? '1' : undefined} class="cta absolute inset-0 z-10 flex items-end justify-end p-2.5 md:p-4" aria-label={p.data.embed ? `Probar ${p.data.title}` : `Abrir ${p.data.title}`}>
                      <span class="pill">{p.data.embed ? 'Click para probar' : 'Ver proyecto ↗'}</span>
                    </a>
                    {p.data.embed && (
                      <>
                        <span class="live-badge pill pointer-events-none absolute left-2.5 top-2.5 z-20 hidden items-center gap-1.5 md:left-4 md:top-4"><i class="size-1.5 rounded-full bg-mint shadow-[0_0_8px_var(--color-mint)]"></i>En vivo</span>
                        <div class="live-controls absolute right-2.5 top-2.5 z-20 hidden gap-2 md:right-4 md:top-4">
                          <button type="button" data-exit class="pill">Salir</button>
                          <a href={p.data.url} target="_blank" rel="noopener" class="pill">Abrir ↗</a>
                        </div>
                      </>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Panel de información -->
      <div class="info-col grid px-6 pb-14 pt-3 md:px-0 md:pb-16 md:pt-0">
        {projects.map((p, i) => {
          const [head, last] = split(p.data.title);
          return (
            <article data-panel class:list={['panel', i === 0 && 'is-active']} aria-hidden={i !== 0 ? 'true' : undefined}>
              <p class="st eyebrow">{p.data.year ? `${p.data.year} · ` : ''}{p.data.status}</p>
              <h2 class="st mt-3 hidden text-[clamp(2.4rem,3.6vw,3.6rem)] font-bold leading-[1.04] tracking-tight md:block">{head}<span class="text-accent">{last}</span></h2>
              <h2 class="st mt-1.5 text-[clamp(1.9rem,8.5vw,2.4rem)] font-bold leading-none tracking-tight md:hidden">{p.data.name ?? p.data.title}</h2>
              {p.data.tagline && <p class="st mt-1.5 text-[0.95rem] leading-snug text-fg/90 md:hidden">{p.data.tagline}</p>}
              <p class="st mt-2 line-clamp-3 max-w-md text-[0.8rem] leading-relaxed text-muted md:mt-6 md:line-clamp-none md:text-[1.05rem]">{p.data.problem}</p>

              <div class="st mt-8 hidden border-t border-line pt-4 md:block">
                <p class="eyebrow">Capacidades</p>
                <p class="mt-2 text-sm font-medium text-mint">{p.data.capabilities.join(' · ')}</p>
              </div>
              <div class="st mt-3 md:mt-4 md:border-t md:border-line md:pt-4">
                <p class="eyebrow hidden md:block">Tecnologías</p>
                <ul class="flex flex-wrap gap-1.5 md:mt-3 md:gap-2">{p.data.stack.slice(0, 4).map((s) => <li class="chip !px-2.5 !py-1 !text-[0.7rem] md:!px-[0.85rem] md:!py-[0.35rem] md:!text-[0.78rem]">{s}</li>)}</ul>
              </div>
              <div class="st mt-4 hidden border-t border-line pt-4 md:block">
                <p class="eyebrow">Código libre</p>
                <p class="mt-2 flex items-center gap-2 text-sm">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
                  {p.data.openSource ? (
                    <span>Sí{p.data.license && ` · ${p.data.license}`}{p.data.repo && <> · <a href={p.data.repo} target="_blank" rel="noopener" class="link-underline">Repo ↗</a></>}</span>
                  ) : <span class="text-muted">Privado</span>}
                </p>
              </div>
              <div class="st mt-3 flex items-center gap-4 md:mt-8">
                <a href={p.data.url} target="_blank" rel="noopener" class="btn-glow !px-5 !py-2.5 !text-[0.85rem] md:!px-[1.9rem] md:!py-[0.95rem] md:!text-[0.95rem]">
                  Ver proyecto
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
                <span class="text-[0.7rem] text-muted md:hidden">{p.data.openSource ? `Código libre${p.data.license ? ` · ${p.data.license}` : ''}` : 'Código privado'}</span>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- Flechas (desktop) -->
    <button type="button" data-prev class="arrow left-6" aria-label="Proyecto anterior">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" data-next class="arrow right-6" aria-label="Proyecto siguiente">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <!-- Índice (desktop) -->
    <div class="absolute inset-x-0 bottom-0 z-20 hidden items-end gap-10 px-10 pb-7 md:flex">
      <nav class="flex flex-1 gap-6" aria-label="Índice de proyectos">
        {projects.map((p, i) => (
          <button type="button" data-tab={i} class:list={['tab min-w-0 flex-1 truncate pt-4 text-left text-sm text-muted transition-colors hover:text-fg', i === 0 && 'is-active']}>
            <span class="track"></span><span class="fill"></span>
            <span class="mr-3 tabular-nums">{pad(i + 1)}</span>{p.data.title}
          </button>
        ))}
      </nav>
      <a href="#experiencia" class="flex shrink-0 items-center gap-4 text-[0.7rem] uppercase tracking-[0.2em] text-white/70 transition-colors hover:text-white">
        Scroll para explorar <span class="mouse" aria-hidden="true"></span>
      </a>
    </div>

    <!-- Segmentos (mobile) -->
    <div class="absolute inset-x-6 bottom-5 z-20 flex gap-2 md:hidden" aria-hidden="true">
      {projects.map((_, i) => <span data-seg class:list={['seg h-0.5 flex-1', i === 0 && 'is-active']}><span class="track"></span><span class="fill"></span></span>)}
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const media = [...stage.querySelectorAll<HTMLElement>('[data-media]')];
  const panels = [...stage.querySelectorAll<HTMLElement>('[data-panel]')];
  const tabs = [...stage.querySelectorAll<HTMLElement>('[data-tab], [data-seg]')];
  const count = stage.querySelector<HTMLElement>('[data-count]')!;
  const countFill = stage.querySelector<HTMLElement>('[data-count-fill]')!;
  const total = media.length;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(.16,1,.3,1)';
  let current = 0;
  let inView = true;

  /* ---------- Iframes en vivo ---------- */
  const tilt = stage.querySelector<HTMLElement>('[data-tilt]')!;
  const screens = [...stage.querySelectorAll<HTMLElement>('[data-screen]')];
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const fit = () => screens.forEach((sc) => {
    const f = sc.querySelector<HTMLIFrameElement>('[data-frame]');
    if (!f) return;
    const w = sc.clientWidth;
    if (!w) return;
    const vw = w < 520 ? 640 : Number(sc.dataset.vw || 1280);
    f.style.width = `${vw}px`;
    f.style.height = `${(vw * 10) / 16}px`;
    f.style.transform = `scale(${w / vw})`;
  });
  new ResizeObserver(fit).observe(stage);
  fit();
  const loadFrame = (i: number) => {
    const f = screens[i]?.querySelector<HTMLIFrameElement>('[data-frame]');
    if (!f || f.src) return;
    f.addEventListener('load', () => { f.classList.add('opacity-100'); f.classList.remove('opacity-0'); screens[i].classList.add('ready'); }, { once: true });
    f.src = f.dataset.src!;
  };
  let live: HTMLElement | null = null;
  const exitLive = () => {
    live?.classList.remove('live');
    tilt.classList.remove('flat');
    stage.classList.remove('hold');
    live = null;
  };
  screens.forEach((sc) => {
    sc.querySelector<HTMLElement>('[data-cta]')!.addEventListener('click', (e) => {
      if (!canHover || !sc.querySelector('[data-frame]')) return; // móvil / sin iframe: abre el enlace
      e.preventDefault();
      loadFrame(screens.indexOf(sc));
      exitLive();
      live = sc;
      sc.classList.add('live');
      tilt.classList.add('flat');
      stage.classList.add('hold');
    });
    sc.querySelector('[data-exit]')?.addEventListener('click', exitLive);
    sc.addEventListener('pointerleave', () => { if (live === sc) exitLive(); });
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') exitLive(); });
  // Carga el primer iframe cuando termina la intro y el navegador está libre
  const bootFrames = () => (window.requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 400)))(() => loadFrame(current));
  const waitIntro = setInterval(() => { if (!document.getElementById('intro')) { clearInterval(waitIntro); bootFrames(); } }, 300);

  /* ---------- Cambio de proyecto ---------- */
  function go(target: number, dir = target > current ? 1 : -1) {
    const next = (target + total) % total;
    if (next === current) return;
    const prev = current;
    current = next;
    exitLive();
    loadFrame(next);

    [...media, ...panels].forEach((el) => el.getAnimations({ subtree: true }).forEach((a) => a.cancel()));
    media.forEach((m, i) => m.classList.toggle('is-active', i === next || i === prev));
    panels.forEach((p, i) => {
      p.classList.toggle('is-active', i === next || i === prev);
      p.toggleAttribute('aria-hidden', i !== next);
    });
    tabs.forEach((t) => t.classList.toggle('is-active', Number(t.dataset.tab ?? [...t.parentElement!.children].indexOf(t)) === next));

    const done = (el: HTMLElement) => () => { if (current !== prev) el.classList.remove('is-active'); };
    if (reduce) { done(media[prev])(); done(panels[prev])(); }
    else {
      media[prev].animate(
        [{ opacity: 1, transform: 'none', filter: 'blur(0)' }, { opacity: 0, transform: `translateX(${-dir * 90}px) scale(.94)`, filter: 'blur(14px)' }],
        { duration: 450, easing: 'cubic-bezier(.7,0,.84,0)', fill: 'forwards' },
      ).onfinish = done(media[prev]);
      media[next].animate(
        [{ opacity: 0, transform: `translateX(${dir * 90}px) scale(.94)`, filter: 'blur(14px)' }, { opacity: 1, transform: 'none', filter: 'blur(0)' }],
        { duration: 1000, delay: 180, easing: EASE, fill: 'backwards' },
      );
      panels[prev].animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, fill: 'forwards' }).onfinish = done(panels[prev]);
      panels[next].querySelectorAll<HTMLElement>('.st').forEach((el, i) =>
        el.animate(
          [{ opacity: 0, transform: 'translateY(26px)', filter: 'blur(6px)' }, { opacity: 1, transform: 'none', filter: 'blur(0)' }],
          { duration: 850, delay: 240 + i * 65, easing: EASE, fill: 'backwards' },
        ),
      );
      count.animate([{ transform: `translateY(${dir * 100}%)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 600, easing: EASE });
    }
    count.textContent = String(next + 1).padStart(2, '0');
    countFill.style.height = `${((next + 1) / total) * 100}%`;
  }

  stage.querySelectorAll('[data-prev]').forEach((b) => b.addEventListener('click', () => go(current - 1, -1)));
  stage.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => go(current + 1, 1)));
  stage.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.tab))));

  // Autoplay: cuando termina la barra de progreso del proyecto activo, pasa al siguiente
  stage.addEventListener('animationend', (e) => {
    const el = e.target as HTMLElement;
    if (el.classList.contains('fill') && el.parentElement?.classList.contains('is-active')) go(current + 1, 1);
  });

  addEventListener('keydown', (e) => {
    if (!inView || document.getElementById('intro')) return;
    if ((e.target as HTMLElement).closest('input, textarea')) return;
    if (e.key === 'ArrowRight') go(current + 1, 1);
    if (e.key === 'ArrowLeft') go(current - 1, -1);
  });

  // Swipe en mobile
  let sx = 0, sy0 = 0;
  stage.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy0 = e.touches[0].clientY; }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy0;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  });

  // Pausa cuando no se ve
  const setPaused = () => stage.classList.toggle('paused', !inView || document.hidden || !!document.getElementById('intro'));
  new IntersectionObserver(([e]) => { inView = e.isIntersecting; setPaused(); loop(); }, { threshold: 0.35 }).observe(stage);
  document.addEventListener('visibilitychange', setPaused);
  setPaused();
  const introWatch = setInterval(() => { if (!document.getElementById('intro')) { setPaused(); clearInterval(introWatch); } }, 300);

  /* ---------- Parallax (mouse + scroll) con inercia ---------- */
  let tx = 0, ty = 0, px = 0, py = 0, sy = 0, running = false;
  const fine = matchMedia('(pointer: fine)').matches;
  if (fine) addEventListener('pointermove', (e) => {
    tx = (e.clientX / innerWidth - 0.5) * 2;
    ty = (e.clientY / innerHeight - 0.5) * 2;
    loop();
  }, { passive: true });
  addEventListener('scroll', () => loop(), { passive: true });

  function loop() {
    if (reduce || running) return;
    running = true;
    requestAnimationFrame(tick);
  }
  function tick() {
    const tsy = Math.min(scrollY, stage.offsetHeight);
    px += (tx - px) * 0.06;
    py += (ty - py) * 0.06;
    sy += (tsy - sy) * 0.14;
    stage.style.setProperty('--px', px.toFixed(4));
    stage.style.setProperty('--py', py.toFixed(4));
    stage.style.setProperty('--sy', sy.toFixed(2));
    const settled = Math.abs(tx - px) < 0.001 && Math.abs(ty - py) < 0.001 && Math.abs(tsy - sy) < 0.1;
    if (settled || (!inView && Math.abs(tsy - sy) < 0.1)) { running = false; return; }
    requestAnimationFrame(tick);
  }
  loop();
</script>
