---
import { site } from '../data/site';
const [h1, h2, h3] = site.skillsHeading;
const { skills, soft, about } = site;
---
<section id="habilidades" class="relative flex min-h-dvh flex-col justify-center overflow-clip px-6 pb-8 pt-20 md:block md:min-h-0 md:px-10 md:py-36" aria-label="Habilidades">
  <div class="pointer-events-none absolute -right-40 top-10 size-[34rem] rounded-full bg-accent/10 blur-[140px]" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl gap-5 md:grid-cols-[1fr_1.35fr] md:gap-20">
    <div class="md:sticky md:top-32 md:self-start">
      <p class="reveal eyebrow">Habilidades</p>
      <h2 class="reveal mt-3 text-[clamp(1.9rem,8.4vw,2.4rem)] font-bold leading-[1.08] tracking-tight md:text-[clamp(2.4rem,5vw,4.2rem)] md:leading-[1.05]" style="--i:1">
        {h1}<br /><span class="text-gradient">{h2}</span><br />{h3}
      </h2>
      <p class="reveal soft mt-3 text-[0.8rem] leading-relaxed text-muted md:mt-6 md:text-base" style="--i:2">{soft.join(' · ')}</p>
    </div>

    <div class="space-y-4 md:space-y-8">
      {skills.map((g, i) => (
        <div class="reveal" style={`--i:${i + 1}`}>
          <p class="eyebrow">{g.label}</p>
          <ul class="mt-2 flex flex-wrap gap-1.5 md:mt-3 md:gap-2">
            {g.items.map((s) => <li class:list={['chip !px-2.5 !py-1 !text-[0.7rem] md:!px-[0.85rem] md:!py-[0.35rem] md:!text-[0.78rem]', g.ai && '!border-accent/35 !bg-accent/10 !text-[#dfe2ff]']}>{s}</li>)}
          </ul>
        </div>
      ))}

      <dl class="reveal grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-4 text-[0.8rem] md:grid-cols-3 md:gap-x-6 md:pt-6 md:text-sm" style="--i:3">
        <div class="col-span-2 md:col-span-1">
          <dt class="eyebrow">Estudios</dt>
          <dd class="mt-1 text-fg/90">{about.studies.title}<span class="block text-muted">{about.studies.detail}</span></dd>
        </div>
        <div>
          <dt class="eyebrow">Idiomas</dt>
          <dd class="mt-1 text-fg/90">{about.languages.map((l) => <span class="block">{l}</span>)}</dd>
        </div>
        <div class="int">
          <dt class="eyebrow">Intereses</dt>
          <dd class="mt-1 text-fg/90">{about.interests.slice(0, 3).map((l) => <span class="block">{l}</span>)}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
